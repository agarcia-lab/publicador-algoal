# Copia este fichero como .env (cp env.ejemplo .env) y rellénalo. .env NUNCA va a git ni se pega en un chat.

# --- Instagram (developers.facebook.com → tu app → Instagram → API con inicio de sesión de Instagram → Generar token)
IG_TOKEN=
IG_USER_ID=            # lo rellena solo: herramientas/programar … o  python3 herramientas/ig_api.py yo
IG_TOKEN_FECHA=        # AAAA-MM-DD del día que generaste la llave (el programador la renueva a los 50 días)

# --- Dónde dejar los vídeos con enlace público (Instagram los descarga de ahí). Cloudflare R2 (10 GB gratis):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=         # https://pub-xxxx.r2.dev  (Ajustes del bucket → Acceso público → r2.dev)
# O, si ya sincronizas una carpeta con una web pública, en vez de R2:
# VIDEO_URL_BASE=https://tu-sitio.com/reels

# --- Parte de la mañana por Telegram (opcional: @BotFather → token; tu chat_id con @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
